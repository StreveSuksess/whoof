---
import LifeGallery from './LifeGallery.astro';
const facts = [
  { id:'weight', number:'01', value:'≈ 8', unit:'г', caption:'Вес трекера' },
  { id:'battery', number:'02', value:'До 7', unit:'дней', caption:'Без подзарядки' },
  { id:'activity', number:'03', value:'Активность и отдых', unit:'', caption:'В приложении Whoof' },
];
---
<div id="opening-loader" aria-hidden="true">
  <img src="/whoof/logo.svg" alt="" class="loader-logo" />
  <svg class="collar-drawing" viewBox="0 0 600 480" fill="none">
    <g class="drawing-guides"><path d="M65 45V435M535 45V435M40 90H560M40 390H560M300 35V445M30 240H570"/><path d="M65 90H535V390H65Z" stroke-dasharray="3 5"/><circle cx="65" cy="90" r="4"/><circle cx="535" cy="390" r="4"/><circle cx="300" cy="90" r="3"/><circle cx="300" cy="390" r="3"/></g>
    <ellipse cx="300" cy="240" rx="220" ry="145" class="drawing-outline"/>
    <ellipse cx="300" cy="240" rx="210" ry="135" class="drawing-inner"/>
    <ellipse cx="300" cy="240" rx="220" ry="145" class="drawing-progress" pathLength="100"/>
    <rect x="258" y="365" width="84" height="38" rx="15" class="drawing-outline"/><rect x="275" y="373" width="50" height="20" rx="10" class="drawing-outline"/>
  </svg>
  <div class="loader-caption"><span>ЗНАКОМИМСЯ С WHOOF</span><span id="loader-percent">00</span></div>
</div>
<div class="opening-world" aria-hidden="true">
  <div class="world-backdrop"></div>
  <div id="hero-plate" aria-hidden="true">
    <picture class="hero-beauty"><source media="(max-aspect-ratio: 1/1)" srcset="/whoof/hero-v24/portrait.webp"/><img src="/whoof/hero-v24/landscape.webp" alt="" width="2560" height="1600" fetchpriority="high" /></picture>
  </div>
  <div id="opening-canvas"></div>
  <img class="model-fallback" src="/whoof/device-photo.jpg" alt="" />
  <div class="hero-vignette"></div>
  <div class="world-grain"></div>
</div>
<header class="opening-header">
  <a class="opening-logo" href="#intro" aria-label="Whoof — начало"><img src="/whoof/wordmark.svg" alt="Whoof" width="107" height="22" /></a>
  <nav aria-label="Основная навигация"><a href="#intro" class="nav-intro" aria-current="true">Знакомство</a><a href="#details" class="nav-details">В деталях</a><a href="#life" class="nav-life">Каждый день</a><a href="https://whoof.ru/" target="_blank" rel="noopener noreferrer">Предзаказ <span aria-hidden="true">↗</span></a></nav>
</header>
<main id="opening-content">
  <section id="intro" aria-labelledby="intro-title">
    <div class="hero-ui">
      <div class="hero-tagline">ДЛЯ ЕГО ЖИЗНИ.<br/>ДЛЯ ВАШЕЙ БЛИЗОСТИ.</div>
      <h1 id="intro-title">Его мир.<br/>Теперь ближе.</h1>
      
      <a class="scroll-invite" href="#details"><span class="scroll-circle" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="3"/></svg></span> ЛИСТАЙТЕ ДАЛЬШЕ</a>
    </div>
      <article class="hero-glass">
        <h2>КАЖДЫЙ ДЕНЬ <br/>ВАШЕЙ СОБАКИ. <br/>В ДЕТАЛЯХ.</h2>
        <div class="hero-glass-bottom">
          <div class="dashed-rule"></div>
          <p>Активность и отдых — <br/>в приложении Whoof.</p>
        </div>
      </article>
  </section>
  <section id="details" aria-label="Whoof в деталях">
    <div class="details-ui">
      <div class="detail-facts">
        {facts.map((f,i)=><article class={`detail-fact detail-fact-${f.id}`} data-property={i}>
          <h2 class="detail-value" aria-label={`${f.value} ${f.unit}`.trim()}>
            {f.id==='activity' ? <>Активность <br/>и отдых</> : <>{f.value}<span class="detail-unit"> {f.unit}</span></>}
          </h2>
          <p class="detail-caption">{f.caption}</p>
        </article>)}
      </div>
      <nav class="detail-steps" aria-label="Характеристики Whoof">{facts.map((f,i)=><button data-step={i} aria-label={`${f.value} ${f.unit} — ${f.caption}`}><span>{f.number}</span><i aria-hidden="true"></i></button>)}</nav>
    </div>
  </section>
  <LifeGallery />
</main>
<div class="opening-progress" aria-hidden="true"><span></span></div>
