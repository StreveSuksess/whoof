---
import Accordion from './Accordion.astro';
const plans=[
 {id:'year',checkout:'one-year',tab:'1 год',title:'Первый год с Whoof.',description:'Трекер, ремешок и приложение. Первый год расширенного сервиса — в комплекте.',price:'14 990',term:'12 месяцев ВУФ+',extra:'Доставка по России'},
 {id:'two-years',checkout:'two-years',tab:'2 года',title:'Ещё год — вместе.',description:'Тот же трекер и сервис. Второй год подписки добавляет 5 000 ₽ к стоимости комплекта.',price:'19 990',term:'24 месяца ВУФ+',extra:'Консультация и бонусы*'},
];
const features=[
 ['Активность и периоды покоя',true],['Дневник и история прогулок',true],['Карта дня и динамика',true],
 ['Расширенная аналитика',false],['Рекомендации и AI-ассистент',false],['Отчёт для ветеринарного специалиста',false],
];
---
<section id="order" class="source-offer" data-block="8" data-tone="dark" aria-labelledby="order-title">
  <div class="offer-product" data-offer-product>
    <div class="offer-stage">
      <div class="offer-ghosts" aria-hidden="true">{['collar','walk','rest','day'].map(name=><img src={'/whoof/offer-v37/'+name+'.webp'} alt="" loading="lazy" decoding="async" width="1024" height="683"/>)}</div>
      <div class="offer-model-host" data-offer-model aria-hidden="true"></div>
      <picture class="offer-fallback" aria-hidden="true"><source media="(max-width:600px)" srcset="/whoof/hero-v24/portrait-collar.webp"/><img src="/whoof/hero-v24/landscape-collar.webp" alt="" loading="lazy"/></picture>
      <div class="offer-picker">
        <p class="offer-picker-caption">Выберите свой</p>
        <h2 id="order-title"><span class="offer-sr">Комплект Whoof</span><img src="/whoof/wordmark.svg" alt="" width="107" height="22"/></h2>
        <div class="offer-tabs" role="tablist" aria-label="Срок подписки в комплекте">{plans.map((plan,index)=><button type="button" id={'offer-tab-'+plan.id} role="tab" aria-controls={'offer-panel-'+plan.id} aria-selected={index===0?'true':'false'} tabindex={index===0?0:-1} data-offer-tab>{plan.tab}</button>)}</div>
      </div>
      {plans.map((plan,index)=><div class="offer-panel" id={'offer-panel-'+plan.id} role="tabpanel" aria-labelledby={'offer-tab-'+plan.id} data-offer-panel hidden={index!==0}>
        <div class="offer-summary"><h3>{plan.title}</h3><p data-offer-description>{plan.description}</p><div class="offer-amount">{plan.price}<span>₽</span></div></div>
        <div class="offer-inclusions"><ul><li>Устройство, ремешок и приложение</li><li><a href="#order-service" aria-label={'Что входит в '+plan.term}>{plan.term} <span aria-hidden="true">↘</span></a></li><li>{plan.extra}</li></ul><a class="offer-checkout" href={'https://whoof.ru/checkout.html?plan='+plan.checkout} target="_blank" rel="noopener noreferrer" aria-label={'Предзаказ Whoof на '+plan.tab+' за '+plan.price+' рублей'}>К предзаказу <span aria-hidden="true">↗</span></a><p>{index===0?'Выбранный комплект сохранится при оформлении.':'* Формат консультации и состав бонусов уточняются до оплаты. Доставка по России включена.'}</p></div>
      </div>)}
    </div>
  </div>
  <div class="offer-conditions">
    <dl class="offer-device-facts" aria-label="Устройство в повседневности"><div><dt>≈ 8 г</dt><dd>трекер без ремешка</dd></div><div><dt>42 × 22 × 12 мм</dt><dd>размер корпуса</dd></div><div><dt>до 7 дней</dt><dd>между зарядками, зависит от использования</dd></div><div><dt>Отдельный поводок</dt><dd>крепится к вашему ошейнику или шлейке</dd></div></dl>
    <div id="order-service" class="offer-service">
      <div class="offer-service-intro"><h3>Трекер — ваш.<br/>Сервис — на выбор.</h3><p>В комплекте уже есть год или два ВУФ+. После этого можно продлить расширенные возможности. Сейчас — 6 000 ₽ в год.</p><p>Дополнительный год в двухлетнем комплекте стоит 5 000 ₽. Это тот же сервис на больший срок.</p></div>
      <div class="offer-service-matrix"><table><caption>Опубликованный состав сервиса</caption><thead><tr><th scope="col">Возможности</th><th scope="col">База</th><th scope="col">ВУФ+</th></tr></thead><tbody>{features.map(([feature,base])=><tr><th scope="row">{feature}</th><td aria-label={base?'Включено':'Не включено'}>{base?'✓':'—'}</td><td aria-label="Включено">✓</td></tr>)}</tbody></table><p>Функции вводятся поэтапно. Доступный набор фиксируется до оплаты. Базовые возможности после подписки зависят от версии приложения — это условие п. 21.3 оферты.</p></div>
    </div>
    <div class="offer-preorder"><h3>Вы оформляете<br/>предзаказ.</h3><div><p>Доставка по России включена. Подтверждённая дата отправки и версии iOS/Android пока не опубликованы.</p><p>До оплаты запросите дату, ссылку на актуальное приложение и список работающих функций для вашего телефона.</p><a href="mailto:tech@whoof.ru?subject=Готовность%20Whoof%20к%20предзаказу">Узнать готовность Whoof <span aria-hidden="true">↗</span></a></div></div>
    <Accordion id="order-subscription" title="Что происходит после года или двух"><p>Устройство остаётся вашим. Если не покупать новую подписку, платные возможности ВУФ+ перестают работать. Новый трекер для продления не нужен.</p><p>Стоимость следующей подписки определяется на дату продления; текущие 6 000 ₽ в год не фиксируют будущую цену. Для оплаченного 24-месячного периода оферта исключает автоматическое продление. Гарантированный минимум базы для вашей версии приложения и условия годового комплекта уточняются до оплаты.</p><a href="https://whoof.ru/legal.html?legal=offer" target="_blank" rel="noopener noreferrer">Подписка и её окончание · п. 20–21 ↗</a></Accordion>
    <Accordion id="order-shipping" title="Комплект, зарядка, гарантия и возврат"><p>В комплект входят трекер с ремешком, приложение и выбранный срок ВУФ+. Способ крепления и комплект зарядных аксессуаров уточняются при заказе. Зарядка занимает ориентировочно 1,5–2 часа.</p><p>Гарантия — 1 год с получения. Исправное устройство можно вернуть в течение 7 дней после передачи при соблюдении условий сохранности и комплектации. Возврат устройства и отказ от цифровых услуг рассчитываются отдельно по условиям оферты.</p><a href="https://whoof.ru/legal.html?legal=offer" target="_blank" rel="noopener noreferrer">Условия продажи и возврата ↗</a><a href="mailto:tech@whoof.ru?subject=Вопрос%20о%20комплекте%20Whoof">Вопрос о комплекте ↗</a></Accordion>
  </div>
</section>
