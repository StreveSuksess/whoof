<div class="entry-loader" data-entry-loader role="status" aria-label="Загружаем Whoof">
  <div class="entry-curtain" data-entry-curtain></div>
  <div class="entry-identity" data-entry-identity>
    <svg class="entry-symbol" viewBox="-4 -4 303 326" aria-hidden="true">
      <defs>
        <!-- Exact Whoof brand mark, including both original cutouts. -->
        <path id="whoof-entry-mark" d="M60.8289 76.0977C104.38 -55.8374 223.505 8.20558 209.415 85.0636C234.606 79.5118 284.987 58.1617 293.954 85.0636C298.739 99.4195 275.595 152.951 261.931 178.567C289.599 304.609 199.166 299.4 150.491 281.04C56.9852 382.232 -49.3271 247.737 24.9637 164.478C-17.05 106.068 31.3679 81.2204 60.8289 76.0977ZM179.691 43.9093C171.936 43.2712 164.472 57.0429 163.022 74.669C161.572 92.2949 166.684 107.101 174.439 107.739C182.195 108.377 189.658 94.6057 191.108 76.9796C192.558 59.3536 187.447 44.5477 179.691 43.9093ZM272.837 76.8536C265.087 76.1493 258.399 80.0387 257.899 85.5411C257.399 91.0434 263.276 96.075 271.026 96.7794C278.776 97.4836 285.463 93.5941 285.964 88.0919C286.464 82.5895 280.586 77.5579 272.837 76.8536Z"/>
        <clipPath id="whoof-entry-clip" clipPathUnits="userSpaceOnUse"><use href="#whoof-entry-mark"/></clipPath>
        <linearGradient id="whoof-entry-ink" x1="0" y1="0" x2="0" y2="318" gradientUnits="userSpaceOnUse"><stop stop-color="#faf9f3"/><stop offset="1" stop-color="#d5d7cc"/></linearGradient>
      </defs>
      <use class="entry-empty" href="#whoof-entry-mark"/>
      <g clip-path="url(#whoof-entry-clip)">
        <path data-entry-liquid-back fill="#f1eee6" fill-opacity=".24" d="M-12 330H307V340H-12Z"/>
        <path data-entry-liquid fill="url(#whoof-entry-ink)" d="M-12 330H307V340H-12Z"/>
        <path data-entry-surface fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="1"/>
      </g>
    </svg>
  </div>
  <button class="entry-continue" type="button" data-entry-continue hidden>Перейти к сайту <span aria-hidden="true">↗</span></button>
</div>
<script is:inline>
  (()=>{
    const html=document.documentElement,loader=document.querySelector('[data-entry-loader]'),button=loader.querySelector('[data-entry-continue]');
    loader.dataset.started=String(performance.now());loader.dataset.state='loading';html.classList.add('has-entry-loader');
    const release=reason=>{
      if(loader.dataset.state==='done'||loader.dataset.state==='bypassed')return;
      loader.dataset.state='bypassed';loader.dataset.reason=reason;loader.hidden=true;
      if(!loader.dataset.controlled)loader.dataset.nativeOnly='true';
      html.classList.remove('has-entry-loader','entry-revealing');document.body.classList.add('is-ready');
      const content=document.querySelector('.landing-v27');if(content){content.inert=false;content.removeAttribute('aria-busy');}
      clearTimeout(deadline);clearTimeout(continueTimer);dispatchEvent(new Event('whoof-entry-bypass'));
    };
    const continueTimer=setTimeout(()=>{button.hidden=false;},3000);
    const deadline=setTimeout(()=>release('timeout'),8000);
    button.addEventListener('click',()=>release('skip'));
    addEventListener('whoof-entry-complete',()=>{clearTimeout(deadline);clearTimeout(continueTimer);},{once:true});
  })();
</script>
