---
import Hero from './Hero.astro';
import Stories from './Stories.astro';
import OwnerMotives from './OwnerMotives.astro';
import AppExample from './AppExample.astro';
import HowItWorks from './HowItWorks.astro';
import Trust from './Trust.astro';
import Wearing from './Wearing.astro';
import Offer from './Offer.astro';
import Faq from './Faq.astro';
---
<div class="landing-v27">
  <a class="skip-link" href="#situations">К содержанию</a>
  <div class="opening-world" aria-hidden="true"><div class="world-backdrop"></div><div id="hero-plate"><picture class="hero-beauty"><source media="(max-aspect-ratio:1/1)" srcset="/whoof/hero-v24/portrait.webp"/><img src="/whoof/hero-v24/landscape.webp" alt="" width="2560" height="1600" fetchpriority="high"/></picture></div><div id="opening-canvas"></div><div class="hero-vignette"></div></div>
  <header class="opening-header"><a class="opening-logo" href="#intro" aria-label="Whoof — начало"><img src="/whoof/wordmark.svg" alt="Whoof" width="107" height="22"/></a><nav aria-label="Основная навигация"><a href="#app">В приложении</a><a href="#wearing">Устройство</a><a class="header-order" href="#order">Предзаказ <span aria-hidden="true">↗</span></a></nav></header>
  <main id="landing-content"><Hero/><Stories/><OwnerMotives/><AppExample/><HowItWorks/><Trust/><Wearing/><Offer/><Faq/></main>
  <footer class="landing-footer"><a href="#intro" aria-label="Whoof — к началу"><img src="/whoof/wordmark.svg" alt="Whoof" width="107" height="22"/></a><div><a href="https://whoof.ru/legal.html?legal=offer" target="_blank" rel="noopener noreferrer">Условия продажи ↗</a><a href="https://whoof.ru/legal.html?legal=privacy" target="_blank" rel="noopener noreferrer">Политика конфиденциальности ↗</a><a href="https://whoof.ru/legal.html?legal=company" target="_blank" rel="noopener noreferrer">ООО «ВУФ» ↗</a></div><p>© Whoof, 2026</p></footer>
  <div class="opening-progress" aria-hidden="true"><span></span></div>
</div>
