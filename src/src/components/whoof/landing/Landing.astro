---
import Hero from './Hero.astro';
import Stories from './Stories.astro';
import OwnerMotives from './OwnerMotives.astro';
import AppExample from './AppExample.astro';
import HowItWorks from './HowItWorks.astro';
import Trust from './Trust.astro';
import Offer from './Offer.astro';
import Faq from './Faq.astro';
import Ending from './Ending.astro';
import EntryLoader from './EntryLoader.astro';
---
<EntryLoader/>
<div class="landing-v27">
  <a class="skip-link" href="#situations">К содержанию</a>
  <div class="opening-world" aria-hidden="true"><div class="world-backdrop"></div><div class="situations-atmosphere"></div><div id="hero-plate"><picture class="hero-beauty"><source media="(max-aspect-ratio:1/1)" srcset="/whoof/hero-v24/portrait.webp"/><img src="/whoof/hero-v24/landscape.webp" alt="" width="2560" height="1600" fetchpriority="high"/></picture></div><div id="opening-canvas"></div><div class="hero-vignette"></div></div>
  <div class="product-passage-world" data-product-passage aria-hidden="true"><div class="product-passage-paper"></div><div class="product-passage-dark"></div><div class="product-passage-canvas" data-passage-canvas></div></div>
  <div class="header-scrim" aria-hidden="true"></div>
  <header class="opening-header"><a class="opening-logo" href="#intro" aria-label="Whoof — начало"><img src="/whoof/wordmark.svg" alt="Whoof" width="107" height="22"/></a><nav aria-label="Основная навигация"><a href="#app">В приложении</a><a href="#trust">Устройство</a><a class="header-order" href="#order">Предзаказ <span aria-hidden="true">↗</span></a></nav></header>
  <main id="landing-content"><Hero/><Stories/><OwnerMotives/><AppExample/><HowItWorks/><Trust/><Offer/><Faq/></main>
  <Ending/>
  <div class="opening-progress" aria-hidden="true"><span></span></div>
</div>
