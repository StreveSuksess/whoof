---
import {faq} from '../../../engine/whoof/landing/content';
import Accordion from './Accordion.astro';
---
<section id="faq" class="editorial-section faq-section" data-block="9" data-tone="dark" aria-labelledby="faq-title">
  <div class="faq-layout"><div><span class="small-label">Разберём детали</span><h2 id="faq-title" data-reveal>Остались<br/> вопросы?</h2><a href="mailto:tech@whoof.ru">tech@whoof.ru ↗</a></div><div class="faq-list">{faq.map((f,index)=><Accordion id={'faq-'+(index+1)} title={f.q}><p>{f.a}</p></Accordion>)}</div></div>
</section>
