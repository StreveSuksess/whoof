<div id="grip" class="section">
  <div class="section__inner o-container">
    <div id="grip-header">
      <div id="grip-tagline" class="sub1">Продуманные детали</div>
      <h2 id="grip-title">Лёгкий трекер.<br>На каждый день.</h2>
      <div id="grip-desc" class="body2">Около 8 граммов и регулируемый ремешок.<br>Поводок крепится к отдельному<br>ошейнику или шлейке.</div>
    </div>
    <div id="grip-zoom-box" class="sub2 prevent-select">
      <div id="grip-zoom-box__inner">
        <div id="grip-zoom-box__image"></div>
        <div id="grip-zoom-box__content">
          <div id="grip-zoom-box__content-bg"></div>
          <div id="grip-zoom-box__content-label">Рассмотрите поверхность</div>
          <div id="grip-zoom-box__content-coeff">WHOOF</div>
        </div>
      </div>
    </div>
    <div id="grip-instruction">
      <svg id="grip-instruction-wheel" viewBox="0 0 100 15">
        <path fill="none" stroke="currentColor" stroke-width="0.25" d="M50,12.125c32,0,50,-8.5,50,-10" stroke-dasharray="1 1"></path>
        <path fill="none" stroke="currentColor" stroke-width="0.25" d="M50,12.125c-32,0,-50,-8.5,-50,-10" stroke-dasharray="1 1"></path>
        <circle cx="50" cy="12.125" r="0.8" fill="currentColor"></circle>
        <circle id="grip-instruction-wheel-circle" cx="50" cy="12.125" r="1.8" fill="currentColor"></circle>
      </svg>
      <svg id="grip-instruction-icon"><use href="#hand-tmpl"></use></svg>
    </div>
  </div>
</div>
