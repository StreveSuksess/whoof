---
import fs from 'node:fs';
const manifestPath = `${process.cwd()}/public/whoof/companion-film/sequence/manifest.json`;
const manifest = fs.existsSync(manifestPath) ? '/whoof/companion-film/sequence/manifest.json' : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex,nofollow"/>
    <title>Whoof — фотографический прототип</title>
    <link rel="icon" href="/whoof/favicon.svg" type="image/svg+xml"/>
  </head>
  <body>
    <main class="film-review" data-film data-manifest={manifest} data-ready="false">
      <section class="shot" data-stage aria-label="Портрет собаки с Whoof">
        <img class="anchor" src="/whoof/companion-film/poster-happy-v2.webp" alt="Золотистый ретривер с радостным выражением и чёрным ошейником Whoof в мягком свете" width="1672" height="941" fetchpriority="high"/>
        <canvas aria-hidden="true"></canvas>
        <header><a href="/" aria-label="К лендингу Whoof"><img src="/whoof/wordmark.svg" alt="Whoof" width="107" height="22"/></a><a href="/#details">В деталях <span aria-hidden="true">↗</span></a></header>
        <div class="copy"><h1>За каждой<br/>цифрой —<br/> его день.</h1><a href="https://whoof.ru/" target="_blank" rel="noopener noreferrer">Ближе с Whoof <span aria-hidden="true">↗</span></a></div>
        <div class="shot-note"><span class="dot"></span><span data-status aria-live="polite">{manifest ? 'Подготовка кадров…' : 'Опорный кадр · движение ещё не сгенерировано'}</span></div>
      </section>
      <details class="review-tools">
        <summary>Проверка движения <span aria-hidden="true">+</span></summary>
        <div class="tools-body">
          <div class="tool-heading"><p>Поворот головы</p><output aria-label="Текущий кадр">— / —</output></div>
          <input data-position type="range" min="0" max="1" step="0.001" value="0.5" aria-label="Положение головы" disabled/>
          <div class="poses"><button data-pose="0" disabled>Влево</button><button data-pose="neutral" disabled>Прямо</button><button data-pose="1" disabled>Вправо</button></div>
          <div class="tools-footer"><label class="load-film">Открыть видео с компьютера<input data-file type="file" accept="video/mp4,video/webm,video/quicktime"/></label><a href="/whoof/companion-film/anchor-happy-v2.png" download>Скачать исходный кадр ↗</a></div>
          <p class="help">Видео открывается только в этом браузере и никуда не отправляется. Для проверки подойдёт короткий ролик с неподвижной камерой и одним поворотом головы. Обычный MP4 здесь служит для черновой проверки; финальную последовательность подготовим отдельно для плавного управления.</p>
        </div>
      </details>
    </main>
    <script>
      import { FramePlayer } from '../engine/whoof/companion-film/FramePlayer';
      const root = document.querySelector<HTMLElement>('[data-film]');
      if (root) {
        try { new FramePlayer(root); }
        catch { root.querySelector('[data-status]')!.textContent = 'Опорный кадр · просмотр движения недоступен'; }
      }
    </script>
  </body>
</html>
<style is:global>
  @font-face{font-family:WhoofInter;src:url('/whoof/inter-regular.ttf') format('truetype');font-weight:400;font-display:swap}
  @font-face{font-family:WhoofInter;src:url('/whoof/inter-medium.ttf') format('truetype');font-weight:500;font-display:swap}
  @font-face{font-family:WhoofInter;src:url('/whoof/inter-semibold.ttf') format('truetype');font-weight:600 900;font-display:swap}
  *{box-sizing:border-box}body{margin:0;background:#eeeae3;color:#26272c;font:14px WhoofInter,Inter,Arial,sans-serif;-webkit-font-smoothing:antialiased}a{color:inherit;text-decoration:none}button,input{font:inherit}button,a,label,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,summary:focus-visible,.load-film:focus-within{outline:2px solid #26272c;outline-offset:6px}
  .shot{position:relative;min-height:680px;height:100svh;overflow:hidden;background:#d7d2c8;isolation:isolate}
  .anchor,canvas{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 50%}
  canvas{opacity:0;pointer-events:none}[data-ready=true] canvas{opacity:1}
  header{position:absolute;inset:34px 4.5% auto;display:flex;justify-content:space-between;align-items:center;z-index:2}header img{width:132px;height:auto}header>a:last-child{font-size:12px;text-transform:uppercase;letter-spacing:-.02em}header span{margin-left:16px;font-size:19px}
  .copy{position:absolute;left:7.5%;top:32%;width:35%;pointer-events:none}.copy h1{font-size:clamp(46px,6.4vw,112px);line-height:.99;font-weight:530;letter-spacing:-.07em;margin:0}.copy>a{display:inline-flex;align-items:center;gap:42px;pointer-events:auto;margin-top:42px;font-size:15px;letter-spacing:-.03em;border-bottom:1px solid #26272c66;padding:10px 0}.copy>a span{font-size:22px}
  .shot-note{position:absolute;left:4.5%;bottom:26px;display:flex;align-items:center;gap:10px;font-size:11px;color:#3e403e;max-width:85%;line-height:1.5}.dot{width:5px;height:5px;background:currentColor;border-radius:50%;flex:none}
  .review-tools{max-width:1440px;margin:auto;padding:0 4.5%;background:#eeeae3}.review-tools summary{display:flex;justify-content:space-between;cursor:pointer;list-style:none;padding:24px 0;font-size:13px;letter-spacing:-.02em;border-bottom:1px solid #26272c22}.review-tools summary::-webkit-details-marker{display:none}.review-tools summary span{font-size:20px;font-weight:300}.tools-body{padding:22px 0 30px;max-width:760px}.tool-heading{display:flex;justify-content:space-between;align-items:center}.tool-heading p{margin:0 0 14px}output{font-size:11px;font-variant-numeric:tabular-nums;color:#686b69}input[type=range]{width:100%;accent-color:#26272c}.poses{display:flex;justify-content:space-between;margin:12px 0 26px}.poses button{border:0;background:none;padding:8px 0;color:inherit;cursor:pointer;font-size:12px}.poses button:disabled{opacity:.3;cursor:default}.tools-footer{display:flex;gap:25px;align-items:center;flex-wrap:wrap;font-size:12px}.load-film{border:1px solid #26272c44;padding:13px 16px;border-radius:2px;cursor:pointer;position:relative}.load-film input{position:absolute;width:1px;height:1px;opacity:0}.help{font-size:12px;line-height:1.7;max-width:670px;color:#6b6b66;margin:22px 0 0}
  @media(max-aspect-ratio:6/5){.shot{min-height:730px}.anchor{object-position:71% 50%}.copy{left:7%;top:auto;bottom:12%;width:85%}.copy h1{font-size:clamp(44px,7.8vw,74px);line-height:1.04}.copy h1 br:nth-child(2){display:none}.copy>a{margin-top:20px}.shot:after{content:'';position:absolute;inset:55% 0 0;background:linear-gradient(transparent,#ddd7ceee);z-index:-0;pointer-events:none}.copy,.shot-note{z-index:1}header{inset:26px 6% auto}header img{width:115px}.shot-note{left:6%;font-size:10px;bottom:22px}}
  @media(max-width:600px){.shot{height:100svh;min-height:680px}.anchor{object-position:71% 50%}.copy{left:6%;bottom:13%}.copy h1{font-size:clamp(42px,11vw,62px);max-width:92%}.copy>a{font-size:13px;margin-top:14px}.shot-note{max-width:88%}.review-tools{padding:0 6%}}
  @media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}
</style>
